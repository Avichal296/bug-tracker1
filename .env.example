# Copy to .env before starting Docker Compose.
POSTGRES_PASSWORD=replace-with-a-local-development-password
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=2h
WEB_PORT=8080
AWS_REGION=ap-south-1
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# EC2 image and database values (set in the server's private .env file).
API_IMAGE=ghcr.io/your-account/your-repository-api
WEB_IMAGE=ghcr.io/your-account/your-repository-web
IMAGE_TAG=latest
POSTGRES_DB=bug_tracker_lite
POSTGRES_USER=bug_tracker
DATABASE_URL=postgresql://bug_tracker:replace-me@postgres:5432/bug_tracker_lite?schema=public
