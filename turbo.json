{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@bug-tracker/api#build": {
      "outputs": []
    },
    "start": {
      "cache": false,
      "persistent": true
    }
  }
}
